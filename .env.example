# Copy this file to .env and fill in your real values.

# --- Telegram bot token (from @BotFather) ---
BOT_TOKEN=your_token_here

# --- MongoDB Atlas connection string ---
# Get this from https://cloud.mongodb.com -> Database -> Connect -> Drivers
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/

# Optional: the database name inside MongoDB
MONGO_DB_NAME=task_coach

# --- Render (only needed when hosting on Render) ---
# Render sets RENDER_EXTERNAL_URL and PORT automatically.
# WEBHOOK_SECRET keeps your webhook safe from strangers.
# WEBHOOK_SECRET=change-me-to-something-random

# --- Optional proxy (only if Telegram is blocked by your provider) ---
# PROXY_URL=http://127.0.0.1:7890
